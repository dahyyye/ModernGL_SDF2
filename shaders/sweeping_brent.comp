#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0) uniform sampler3D uBrushSDF;
layout(r32f, binding = 1) uniform writeonly image3D uSweptVolume;

struct KeyFrame {
    vec4 position; // xyz = position
    vec4 rotation; // quaternion (x, y, z, w)
    vec4 scale;    // xyz = scale
};

layout(std430, binding = 2) buffer KeyFrameBuffer {
    KeyFrame keyframes[];
};

uniform vec3  uVolumeMin;
uniform vec3  uVolumeMax;
uniform ivec3 uResolution;
uniform vec3  uBrushMin;
uniform vec3  uBrushMax;
uniform int   uSamplingSteps;
uniform int   uMaxBrentIter;
uniform int   uNumSegments;

// -------------------------------------------------------------------------
// SDF
// -------------------------------------------------------------------------


float sampleLocalSDF(vec3 localPos) // 브러시의 로컬 공간 좌표를 받아서 SDF 값을 반환
{
    vec3 brushRange = uBrushMax - uBrushMin;                    // 브러시 바운딩 박스의 크기 계산
    vec3 uvw = (localPos - uBrushMin) / brushRange;             // 로컬 좌표를 [0, 1] 범위로 정규화

    float outsideDist = 0.0;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) 
    {
        vec3 clamped  = clamp(uvw, vec3(0.0), vec3(1.0));
        outsideDist   = length((uvw - clamped) * brushRange);
        uvw           = clamped;
    }

    return texture(uBrushSDF, uvw).r + outsideDist;
}

// -------------------------------------------------------------------------
// Catmull-Rom
// -------------------------------------------------------------------------

// t in [0, 1] 범위에서 어떤 세그먼트인지(seg) 와 그 세그먼트 안에서의 로컬 시간(lt) 을 반환
int getSegIdx(float t, out float lt)    
{
    float scaled = clamp(t, 0.0, 1.0) * float(uNumSegments);
    int   seg    = clamp(int(scaled), 0, uNumSegments - 1);
    lt           = scaled - float(seg);
    return seg;
}

// 4개의 제어점과 로컬 시간 lt를 받아서 Catmull-Rom 곡선 위의 한 점을 계산
vec3 evalCatmullRomSegmentValue(vec3 k00, vec3 k0, vec3 k1, vec3 k2, float lt)
{
    float lt2 = lt * lt;
    float lt3 = lt2 * lt;
    return 0.5 * ((2.0 * k0)
        + (-k00 + k1)                       * lt
        + (2.0*k00 - 5.0*k0 + 4.0*k1 - k2) * lt2
        + (-k00 + 3.0*k0 - 3.0*k1 + k2)    * lt3);
}

// 4개의 제어점과 로컬 시간 lt를 받아서 Catmull-Rom 곡선 위의 한 점의 미분값을 계산
void evalCatmullRomSegmentValueAndDerivative(
    vec3 k00, vec3 k0, vec3 k1, vec3 k2,
    float lt, float dltDt,
    out vec3 value, out vec3 derivative)
{
    vec3  c1  = -k00 + k1;                          // 1차 계수
    vec3  c2  =  2.0*k00 - 5.0*k0 + 4.0*k1 - k2;    // 2차 계수
    vec3  c3  = -k00 + 3.0*k0 - 3.0*k1 + k2;        // 3차 계수
    float lt2 = lt * lt;
    float lt3 = lt2 * lt;

    value      = 0.5 * ((2.0 * k0) + c1*lt + c2*lt2 + c3*lt3);
    derivative = 0.5 * (c1 + 2.0*c2*lt + 3.0*c3*lt2) * dltDt;   // 미분
}

void getCatmullRomKnots_Pos(int seg,
    out vec3 k00, out vec3 k0, out vec3 k1, out vec3 k2)
{
    k00 = (seg == 0)
        ? 2.0 * keyframes[0].position.xyz - keyframes[1].position.xyz
        : keyframes[seg - 1].position.xyz;
    k0  = keyframes[seg].position.xyz;
    k1  = keyframes[seg + 1].position.xyz;
    k2  = (seg + 2 <= uNumSegments)
        ? keyframes[seg + 2].position.xyz
        : 2.0 * keyframes[uNumSegments].position.xyz - keyframes[uNumSegments - 1].position.xyz;
}

void getCatmullRomKnots_Scale(int seg,
    out vec3 k00, out vec3 k0, out vec3 k1, out vec3 k2)
{
    k00 = (seg == 0)
        ? 2.0 * keyframes[0].scale.xyz - keyframes[1].scale.xyz
        : keyframes[seg - 1].scale.xyz;
    k0  = keyframes[seg].scale.xyz;
    k1  = keyframes[seg + 1].scale.xyz;
    k2  = (seg + 2 <= uNumSegments)
        ? keyframes[seg + 2].scale.xyz
        : 2.0 * keyframes[uNumSegments].scale.xyz - keyframes[uNumSegments - 1].scale.xyz;
}

vec3 catmullRomPosAtSegment(int seg, float lt)
{
    vec3 k00, k0, k1, k2;
    getCatmullRomKnots_Pos(seg, k00, k0, k1, k2);
    return evalCatmullRomSegmentValue(k00, k0, k1, k2, lt);
}

void catmullRomPosAndDerivativeAtSegment(int seg, float lt, float dltDt,
    out vec3 pos, out vec3 posDt)
{
    vec3 k00, k0, k1, k2;
    getCatmullRomKnots_Pos(seg, k00, k0, k1, k2);
    evalCatmullRomSegmentValueAndDerivative(k00, k0, k1, k2, lt, dltDt, pos, posDt);
}

vec3 catmullRomScaleAtSegment(int seg, float lt)
{
    vec3 k00, k0, k1, k2;
    getCatmullRomKnots_Scale(seg, k00, k0, k1, k2);
    return evalCatmullRomSegmentValue(k00, k0, k1, k2, lt);
}

void catmullRomScaleAndDerivativeAtSegment(int seg, float lt, float dltDt,
    out vec3 scl, out vec3 sclDt)
{
    vec3 k00, k0, k1, k2;
    getCatmullRomKnots_Scale(seg, k00, k0, k1, k2);
    evalCatmullRomSegmentValueAndDerivative(k00, k0, k1, k2, lt, dltDt, scl, sclDt);
}

// -------------------------------------------------------------------------
// Quaternion
// -------------------------------------------------------------------------

vec3 quatRotate(vec4 q, vec3 v)
{
    vec3 qv = q.xyz;
    return v + 2.0 * cross(qv, cross(qv, v) + q.w * v);
}

vec4 quatMultiply(vec4 a, vec4 b)
{
    return vec4(
        a.w * b.xyz + b.w * a.xyz + cross(a.xyz, b.xyz),
        a.w * b.w - dot(a.xyz, b.xyz));
}

vec4 quatSlerp(vec4 q0, vec4 q1, float t)
{
    float cosA = clamp(dot(q0, q1), -1.0, 1.0);
    if (cosA < 0.0) { q1 = -q1; cosA = -cosA; }
    if (cosA > 0.9995) return normalize(mix(q0, q1, t));

    float angle = acos(cosA);
    float sinA  = sin(angle);
    return (sin((1.0 - t) * angle) / sinA) * q0
         + (sin(t * angle)         / sinA) * q1;
}

void quatSlerpAndLocalAngularVelocity(
    vec4 q0, vec4 q1, float lt, float dltDt,
    out vec4 rot, out vec3 omegaLocal)
{
    float cosA = clamp(dot(q0, q1), -1.0, 1.0);
    if (cosA < 0.0) { q1 = -q1; cosA = -cosA; }

    vec4 qRel = quatMultiply(vec4(-q0.xyz, q0.w), q1);

    if (cosA > 0.9995)
    {
        rot        = normalize(mix(q0, q1, lt));
        omegaLocal = 2.0 * qRel.xyz * dltDt;
        return;
    }

    float halfAngle = acos(cosA);
    float sinHalf   = sin(halfAngle);

    rot        = (sin((1.0 - lt) * halfAngle) / sinHalf) * q0
               + (sin(lt * halfAngle)          / sinHalf) * q1;
    omegaLocal = (qRel.xyz / sinHalf) * (2.0 * halfAngle * dltDt);
}

// -------------------------------------------------------------------------
// Inverse transform
// -------------------------------------------------------------------------

// 시간 t에서 worldPos를 로컬 공간으로 역변환한 위치만 반환
vec3 evalInvTransformAt(float t, vec3 worldPos)
{
    float lt;
    int   seg    = getSegIdx(t, lt);
    vec3  pos    = catmullRomPosAtSegment(seg, lt);
    vec4  rot    = quatSlerp(keyframes[seg].rotation, keyframes[seg + 1].rotation, lt);
    vec4  invRot = vec4(-rot.xyz, rot.w);
    vec3  scl    = catmullRomScaleAtSegment(seg, lt);
    return quatRotate(invRot, worldPos - pos) / scl;
}

// 위치(localPos)에 더해서 로컬 공간에서의 속도(localVelocity) 까지 동시에 계산
void evalInvTransformAndDerivativeAt(float t, vec3 worldPos,
    out vec3 localPos, out vec3 localVelocity)
{
    float lt;
    int   seg   = getSegIdx(t, lt);
    float dltDt = float(uNumSegments);

    vec3 pos, posDt;
    catmullRomPosAndDerivativeAtSegment(seg, lt, dltDt, pos, posDt);

    vec3 scl, sclDt;
    catmullRomScaleAndDerivativeAtSegment(seg, lt, dltDt, scl, sclDt);

    vec4 rot, invRot;
    vec3 omegaLocal;
    quatSlerpAndLocalAngularVelocity(
        keyframes[seg].rotation, keyframes[seg + 1].rotation,
        lt, dltDt, rot, omegaLocal);
    invRot = vec4(-rot.xyz, rot.w);

    vec3 worldOffset   = worldPos - pos;
    vec3 rotatedOffset = quatRotate(invRot, worldOffset);
    localPos           = rotatedOffset / scl;

    vec3 localPosVelocity  = quatRotate(invRot, posDt);
    vec3 rotatedOffsetDt   = -localPosVelocity - cross(omegaLocal, rotatedOffset);
    localVelocity          = (rotatedOffsetDt - localPos * sclDt) / scl;
}

// -------------------------------------------------------------------------
// Arc length & Brent
// -------------------------------------------------------------------------

// 한 시점 t에서 SDF값과 속력을 동시에 반환하는 함수
void evalSdfAndSpeedAt(float t, vec3 worldPos, out float sdf, out float speed)
{
    vec3 localPos, localVelocity; // 로컬 공간에서의 위치와 속도
    evalInvTransformAndDerivativeAt(t, worldPos, localPos, localVelocity);
    sdf   = sampleLocalSDF(localPos);
    speed = length(localVelocity); // 속력은 로컬 공간에서의 속도 벡터의 길이
}

// 구간 [t0, t1]에서 역변환 궤적의 호길이를 Simpson 공식으로 근사하는 함수
float simpsonArcLength(float t0, float t1, float speed0, float speedMid, float speed1)
{
    return (t1 - t0) * (speed0 + 4.0 * speedMid + speed1) / 6.0;
}

float brentMinimize(float t0, float t1, vec3 worldPos)
{
    const float golden = 0.381966;
    const float tol    = 1e-4;

    float a = 0.0, b = 1.0;
    float x  = a + golden * (b - a);
    float w  = x, v = x;
    float fx = sampleLocalSDF(evalInvTransformAt(mix(t0, t1, x), worldPos));
    float fw = fx, fv = fx;
    float d  = 0.0, e = 0.0;

    for (int iter = 0; iter < uMaxBrentIter; ++iter)
    {
        float mid  = 0.5 * (a + b);
        float tol1 = tol * abs(x) + 1e-10;
        float tol2 = 2.0 * tol1;

        if (abs(x - mid) <= (tol2 - 0.5 * (b - a))) break;

        bool  useParabolic = false;
        float u = 0.0;

        if (abs(e) > tol1)
        {
            float r = (x - w) * (fx - fv);
            float q = (x - v) * (fx - fw);
            float p = (x - v) * q - (x - w) * r;
            q = 2.0 * (q - r);
            if (q > 0.0) p = -p; else q = -q;

            float etemp = e; e = d;
            if (abs(p) < abs(0.5 * q * etemp)
                && p > q * (a - x)
                && p < q * (b - x))
            {
                d = p / q;
                u = x + d;
                if ((u - a) < tol2 || (b - u) < tol2)
                    d = (x < mid) ? tol1 : -tol1;
                useParabolic = true;
            }
        }

        if (!useParabolic)
        {
            e = (x < mid) ? (b - x) : (a - x);
            d = golden * e;
        }

        u = (abs(d) >= tol1) ? x + d : x + ((d > 0.0) ? tol1 : -tol1);

        float fu = sampleLocalSDF(evalInvTransformAt(mix(t0, t1, u), worldPos));

        if (fu <= fx)
        {
            if (u < x) b = x; else a = x;
            v = w; fv = fw;
            w = x; fw = fx;
            x = u; fx = fu;
        }
        else
        {
            if (u < x) a = u; else b = u;
            if (fu <= fw || w == x)              { v = w; fv = fw; w = u; fw = fu; }
            else if (fu <= fv || v == x || v == w) { v = u; fv = fu; }
        }
    }

    return fx;
}

// -------------------------------------------------------------------------
// Main
// -------------------------------------------------------------------------

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, uResolution))) return;

    vec3 spacing  = (uVolumeMax - uVolumeMin) / vec3(uResolution - 1);
    vec3 worldPos = uVolumeMin + vec3(id) * spacing;

    float minSDF = 1e10;

    // 적응형 분할 스택 (구간당 SDF, speed 3점 캐시)
    vec2  stackInterval[64];
    float stackSdfA[64],   stackSdfM[64],   stackSdfB[64];
    float stackSpeedA[64], stackSpeedM[64], stackSpeedB[64];
    int   top = 0;

    float sdf0, speed0, sdfMid, speedMid, sdf1, speed1;
    evalSdfAndSpeedAt(0.0, worldPos, sdf0,   speed0);
    evalSdfAndSpeedAt(0.5, worldPos, sdfMid, speedMid);
    evalSdfAndSpeedAt(1.0, worldPos, sdf1,   speed1);

    stackInterval[0] = vec2(0.0, 1.0);
    stackSdfA[0]   = sdf0;   stackSdfM[0]   = sdfMid;   stackSdfB[0]   = sdf1;
    stackSpeedA[0] = speed0; stackSpeedM[0] = speedMid; stackSpeedB[0] = speed1;
    top = 1;

    const float MIN_INTERVAL_T = 0.0125; // 최소 구간 길이 (t 단위)

    while (top > 0)
    {
        top--;
        float ta = stackInterval[top].x;
        float tb = stackInterval[top].y;

        float sdfa  = stackSdfA[top],   sdfm  = stackSdfM[top],   sdfb  = stackSdfB[top];
        float speedA = stackSpeedA[top], speedM = stackSpeedM[top], speedB = stackSpeedB[top];

        float arcLen = simpsonArcLength(ta, tb, speedA, speedM, speedB);

        // Lipschitz 컬링
        if (sdfa > 0.0 && sdfb > 0.0 && (sdfa + sdfb) > arcLen) // 1.5 : 수치적분 오차 보정용
        {
            minSDF = min(minSDF, min(sdfa, sdfb));
            continue;
        }

        // 구간이 충분히 작으면 Brent로 최솟값 탐색
        if ((tb - ta) < MIN_INTERVAL_T || top + 2 > 64)
        {
            minSDF = min(minSDF, brentMinimize(ta, tb, worldPos));
            continue;
        }

        // 이진 분할: Q1, Q3만 새로 평가하고 나머지는 캐시 재사용
        float tm  = 0.5 * (ta + tb);
        float tq1 = 0.5 * (ta + tm);
        float tq3 = 0.5 * (tm + tb);

        float sdfQ1, speedQ1, sdfQ3, speedQ3;
        evalSdfAndSpeedAt(tq1, worldPos, sdfQ1, speedQ1);
        evalSdfAndSpeedAt(tq3, worldPos, sdfQ3, speedQ3);

        // 왼쪽 자식 [ta, tm]
        stackInterval[top] = vec2(ta, tm);
        stackSdfA[top]   = sdfa;   stackSdfM[top]   = sdfQ1;   stackSdfB[top]   = sdfm;
        stackSpeedA[top] = speedA; stackSpeedM[top] = speedQ1; stackSpeedB[top] = speedM;
        top++;

        // 오른쪽 자식 [tm, tb]
        stackInterval[top] = vec2(tm, tb);
        stackSdfA[top]   = sdfm;   stackSdfM[top]   = sdfQ3;   stackSdfB[top]   = sdfb;
        stackSpeedA[top] = speedM; stackSpeedM[top] = speedQ3; stackSpeedB[top] = speedB;
        top++;
    }

    imageStore(uSweptVolume, id, vec4(minSDF, 0.0, 0.0, 0.0));
}
