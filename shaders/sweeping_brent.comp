// ====================================== 최고속도로 ================================

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, uResolution))) return;

    vec3 volumeRange = uVolumeMax - uVolumeMin;
    vec3 spacing     = volumeRange / vec3(uResolution - 1);
    vec3 worldPos    = uVolumeMin + vec3(id) * spacing;

    float minSDF = 1e10;

    float t0   = 0.0;
    vec3  p0   = evalInvTransformAt(t0, worldPos);
    float sdf0 = sampleLocalSDF(p0);

    for (int seg = 0; seg < uSamplingSteps - 1; ++seg)
    {
        float t1 = float(seg + 1) / float(uSamplingSteps - 1);

        vec3 p1 = evalInvTransformAt(t1, worldPos);
        float sdf1 = sampleLocalSDF(p1);

        // 1차 컬링: 최고속도×시간으로 구한 정확한 arc length 상한 사용 (안전계수 곱하지 않음)
        float segLength = boundedArcLength(t0, t1, worldPos);
        if (sdf0 > 0.0 && sdf1 > 0.0 && (sdf0 + sdf1) > segLength * uSafetyFactor)
        {
            minSDF = min(minSDF, min(sdf0, sdf1));
        }
        else
        {
            // 1차 컬링 실패 시: L개 서브세그먼트로 나눠 다시 컬링 검사 후 Brent로 폴백
            const int L = 10;
            float bestSDF = min(sdf0, sdf1);

            float tPrev = t0;
            vec3  pPrev = p0;
            float sdfPrev = sdf0;

            for (int i = 1; i <= L; ++i)
            {
                float tCurr = mix(t0, t1, float(i) / float(L));
                vec3  pCurr = evalInvTransformAt(tCurr, worldPos);
                float sdfCurr = sampleLocalSDF(pCurr);

                float subLen = boundedArcLength(tPrev, tCurr, worldPos);
                if (sdfPrev > 0.0 && sdfCurr > 0.0 && (sdfPrev + sdfCurr) > subLen* uSafetyFactor)
                {
                    bestSDF = min(bestSDF, min(sdfPrev, sdfCurr));
                }
                else
                {
                    float val = brentMinimize(tPrev, tCurr, worldPos);
                    bestSDF = min(bestSDF, val);
                }

                tPrev = tCurr;
                pPrev = pCurr;
                sdfPrev = sdfCurr;
            }

            minSDF = min(minSDF, bestSDF);
        }

        t0   = t1;
        p0   = p1;
        sdf0 = sdf1;
    }

    imageStore(uSweptVolume, id, vec4(minSDF, 0.0, 0.0, 0.0));
}

// =========================================================================

// 적응적 이등분 depth 하나 (최고속도 기반 arc length 상한으로 컬링).
// NAME은 이 depth의 함수 이름, NEXT는 컬링 실패 시 위임할 다음(한 단계 더 깊은) 함수 이름.
#define DEFINE_SUBDIV_ARC(NAME, NEXT)                                       \
float NAME(float a, float b, vec3 worldPos)                                 \
{                                                                            \
    vec3 pa = evalInvTransformAt(a, worldPos);                             \
    vec3 pb = evalInvTransformAt(b, worldPos);                             \
    float sdfA = sampleLocalSDF(pa);                                       \
    float sdfB = sampleLocalSDF(pb);                                       \
                                                                              \
    float segLength = boundedArcLength(a, b, worldPos);                    \
    if (sdfA > 0.0 && sdfB > 0.0 && (sdfA + sdfB) > segLength)             \
    {                                                                       \
        return min(sdfA, sdfB);                                           \
    }                                                                       \
    float mid = 0.5 * (a + b);                                            \
    return min(NEXT(a, mid, worldPos), NEXT(mid, b, worldPos));            \
}

// 가장 깊은 leaf: 더는 안 쪼개고 곧바로 Brent에 넘긴다.
float evalLeafArc(float a, float b, vec3 worldPos)
{
    vec3 pa = evalInvTransformAt(a, worldPos);
    vec3 pb = evalInvTransformAt(b, worldPos);
    float sdfA = sampleLocalSDF(pa);
    float sdfB = sampleLocalSDF(pb);

    float segLength = boundedArcLength(a, b, worldPos);
    if (sdfA > 0.0 && sdfB > 0.0 && (sdfA + sdfB) > segLength)
    {
        return min(sdfA, sdfB);
    }
    return brentMinimize(a, b, worldPos);
}

// depth를 늘리고 싶으면 DEFINE_SUBDIV_ARC 줄을 하나 더 추가하면 된다.
DEFINE_SUBDIV_ARC(subdivArcL5, evalLeafArc)
DEFINE_SUBDIV_ARC(subdivArcL4, subdivArcL5)
DEFINE_SUBDIV_ARC(subdivArcL3, subdivArcL4)
DEFINE_SUBDIV_ARC(subdivArcL2, subdivArcL3)
DEFINE_SUBDIV_ARC(subdivArcL1, subdivArcL2)
DEFINE_SUBDIV_ARC(subdivArcL0, subdivArcL1)

