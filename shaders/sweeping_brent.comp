#version 430 core

// 워크그룹 하나당 크기 = 8x8x8 = 512 스레드
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0) uniform sampler3D uBrushSDF;
layout(r32f, binding = 1) uniform writeonly image3D uSweptVolume;

// Catmull-Rom 키프레임: 위치(xyz), 회전 쿼터니언(xyzw), 스케일(xyz)
struct KeyFrame {
    vec4 position; // xyz = 위치, w는 안 씀
    vec4 rotation; // 쿼터니언 (x, y, z, w)
    vec4 scale;    // 스케일 (x, y, z), w는 안 씀
};

layout(std430, binding = 2) buffer KeyFrameBuffer {
    KeyFrame keyframes[];
};

uniform vec3 uVolumeMin;
uniform vec3 uVolumeMax;
uniform ivec3 uResolution;
uniform vec3 uSpacing;

uniform vec3 uBrushMin;
uniform vec3 uBrushMax;

uniform int uSamplingSteps;
uniform int uMaxBrentIter;

uniform int uNumSegments;
uniform float uSafetyFactor;   // 예전 Lipschitz 안전계수. 지금 파이프라인에서는 안 쓰임

// 로컬 공간 좌표 하나를 받아 브러시 SDF 값을 샘플링한다.
float sampleLocalSDF(vec3 localPos)
{
    vec3 brushRange = uBrushMax - uBrushMin;
    vec3 uvw = (localPos - uBrushMin) / brushRange;

    float outsideDist = 0.0;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
    {
        vec3 clamped = clamp(uvw, vec3(0.0), vec3(1.0));
        vec3 diff = (uvw - clamped) * brushRange;
        outsideDist = length(diff);
        uvw = clamped;
    }

    return texture(uBrushSDF, uvw).r + outsideDist;
}

// t에 해당하는 키프레임 세그먼트 번호와, 그 세그먼트 안에서의 로컬 파라미터 lt(0~1)를 반환한다.
int getSegIdx(float t, out float lt)
{
    float scaled = clamp(t, 0.0, 1.0) * float(uNumSegments);
    int seg      = clamp(int(scaled), 0, uNumSegments - 1);
    lt           = scaled - float(seg);
    return seg;
}

// 전역 시간 t에서의 Catmull-Rom 위치. 궤적 양 끝에서는 반사된 phantom point를 사용한다.
vec3 catmullRomPos(float t)
{
    float lt;
    int seg = getSegIdx(t, lt);

    vec3 k00 = (seg == 0)
        ? (2.0 * keyframes[0].position.xyz - keyframes[1].position.xyz)
        : keyframes[seg - 1].position.xyz;

    vec3 k0 = keyframes[seg].position.xyz;
    vec3 k1 = keyframes[seg + 1].position.xyz;

    vec3 k2 = (seg + 2 <= uNumSegments)
        ? keyframes[seg + 2].position.xyz
        : (2.0 * keyframes[uNumSegments].position.xyz - keyframes[uNumSegments - 1].position.xyz);

    float lt2 = lt * lt;
    float lt3 = lt2 * lt;

    return 0.5 * ((2.0 * k0)
        + (-k00 + k1)                        * lt
        + (2.0*k00 - 5.0*k0 + 4.0*k1 - k2)  * lt2
        + (-k00 + 3.0*k0 - 3.0*k1 + k2)     * lt3);
}

// 전역 시간 t에서의 Catmull-Rom 스케일. 부호가 뒤집히거나 0으로 나누는 걸 막기 위해
// 아주 작은 양수 하한으로 clamp한다.
vec3 catmullRomScale(float t)
{
    float lt;
    int seg = getSegIdx(t, lt);

    vec3 k00 = (seg == 0)
        ? (2.0 * keyframes[0].scale.xyz - keyframes[1].scale.xyz)
        : keyframes[seg - 1].scale.xyz;

    vec3 k0 = keyframes[seg].scale.xyz;
    vec3 k1 = keyframes[seg + 1].scale.xyz;

    vec3 k2 = (seg + 2 <= uNumSegments)
        ? keyframes[seg + 2].scale.xyz
        : (2.0 * keyframes[uNumSegments].scale.xyz - keyframes[uNumSegments - 1].scale.xyz);

    float lt2 = lt * lt;
    float lt3 = lt2 * lt;

    vec3 result = 0.5 * ((2.0 * k0)
        + (-k00 + k1)                        * lt
        + (2.0*k00 - 5.0*k0 + 4.0*k1 - k2)  * lt2
        + (-k00 + 3.0*k0 - 3.0*k1 + k2)     * lt3);

    return max(result, vec3(1e-4));
}

// 두 회전 쿼터니언 사이의 구면 선형 보간(slerp).
vec4 quatSlerp(vec4 q1, vec4 q2, float t)
{
    float cosA = clamp(dot(q1, q2), -1.0, 1.0);
    if (cosA < 0.0) { q2 = -q2; cosA = -cosA; }
    if (cosA > 0.9995) return normalize(mix(q1, q2, t));

    float angle = acos(cosA);
    float sinA = sin(angle);
    return (sin((1.0 - t) * angle) / sinA) * q1
         + (sin(t * angle)          / sinA) * q2;
}

// 단위 쿼터니언 q로 벡터 v를 회전시킨다.
vec3 quatRotate(vec4 q, vec3 v)
{
    vec3 qv = q.xyz;
    return v + 2.0 * cross(qv, cross(qv, v) + q.w * v);
}

// worldPos를 시간 t에서의 브러시 로컬 공간으로 되돌린다 (위치/회전/스케일의 역변환).
vec3 evalInvTransformAt(float t, vec3 worldPos)
{
    float lt;
    int seg = getSegIdx(t, lt);

    vec3 pos    = catmullRomPos(t);

    vec4 rot    = quatSlerp(keyframes[seg].rotation,
                            keyframes[seg + 1].rotation, lt);
    vec4 invRot = vec4(-rot.xyz, rot.w);

    vec3 scl = catmullRomScale(t);

    // Eq.2 순서: S^-1 * R^T * (x - p)
    vec3 unrotated = quatRotate(invRot, worldPos - pos);
    return unrotated / scl;
}

// 예전 방식: chord 샘플링으로 arc length를 근사(내부 N-1개 샘플). 지금 파이프라인에서는 안 쓰임.
float curveArcLength(float t0, float t1, vec3 worldPos, vec3 p0, vec3 p1)
{
    const int N = 4;
    float len = 0.0;
    vec3 prev = p0;
    for (int i = 1; i < N; ++i)
    {
        float alpha = float(i) / float(N);
        vec3 curr = evalInvTransformAt(mix(t0, t1, alpha), worldPos);
        len += length(curr - prev);
        prev = curr;
    }
    len += length(p1 - prev);
    return len;
}

// 예전 방식: chord(p0-p1 직선)와 실제 곡선 사이의 최대 편차. 지금 파이프라인에서는 안 쓰임.
float maxChordDeviation(float t0, float t1, vec3 worldPos, vec3 p0, vec3 p1)
{
    const int N = 10;
    vec3 chordDir  = p1 - p0;
    float chordLenSq = dot(chordDir, chordDir);

    float maxDev = 0.0;
    for (int i = 1; i < N; ++i)
    {
        float alpha = float(i) / float(N);
        vec3 curr = evalInvTransformAt(mix(t0, t1, alpha), worldPos);

        float tProj = (chordLenSq > 1e-12)
            ? clamp(dot(curr - p0, chordDir) / chordLenSq, 0.0, 1.0)
            : 0.0;
        vec3 closest = p0 + chordDir * tProj;
        maxDev = max(maxDev, length(curr - closest));
    }
    return maxDev;
}

// 2차식 f(x)=a*x^2+b*x+c 의 [x0,x1] 구간 내 |f(x)| 최댓값을 닫힌 형태로 계산 (샘플링 없음).
// 위치/스케일 곡선의 도함수(속도)가 2차식이므로, 이 함수로 그 최고 속도를 정확히 구한다.
float quadMaxAbs(float a, float b, float c, float x0, float x1)
{
    float m = max(abs(a*x0*x0 + b*x0 + c), abs(a*x1*x1 + b*x1 + c));
    if (abs(a) > 1e-12)
    {
        float xv = -b / (2.0 * a);
        if (xv > x0 && xv < x1)
            m = max(m, abs(a*xv*xv + b*xv + c));
    }
    return m;
}

// 3차식 f(x)=c3*x^3+c2*x^2+c1*x+c0 의 [x0,x1] 구간 내 최솟값을 닫힌 형태로 계산 (2차 근의 공식 이용).
// 스케일의 최솟값을 구해서 1/s(t)를 바운드하는 데 사용된다.
float cubicMin(float c3, float c2, float c1, float c0, float x0, float x1)
{
    float m = min(c3*x0*x0*x0 + c2*x0*x0 + c1*x0 + c0,
                  c3*x1*x1*x1 + c2*x1*x1 + c1*x1 + c0);

    float a = 3.0*c3, b = 2.0*c2, c = c1;
    if (abs(a) > 1e-12)
    {
        float disc = b*b - 4.0*a*c;
        if (disc >= 0.0)
        {
            float sq = sqrt(disc);
            float r1 = (-b + sq) / (2.0*a);
            float r2 = (-b - sq) / (2.0*a);
            if (r1 > x0 && r1 < x1) m = min(m, c3*r1*r1*r1 + c2*r1*r1 + c1*r1 + c0);
            if (r2 > x0 && r2 < x1) m = min(m, c3*r2*r2*r2 + c2*r2*r2 + c1*r2 + c0);
        }
    }
    return m;
}

// 속도(|dy/dlt|) 상한을 회전 각속도 + 위치/스케일 도함수로부터 닫힌 형태로 유도한다.
float maxSpeedBoundInSeg(int seg, float lt0, float lt1, float t0, float t1, vec3 worldPos)
{
    // --- 위치(position) Catmull-Rom 계수 ---
    vec3 pk00 = (seg == 0) ? (2.0*keyframes[0].position.xyz - keyframes[1].position.xyz) : keyframes[seg-1].position.xyz;
    vec3 pk0  = keyframes[seg].position.xyz;
    vec3 pk1  = keyframes[seg+1].position.xyz;
    vec3 pk2  = (seg+2 <= uNumSegments) ? keyframes[seg+2].position.xyz
                                        : (2.0*keyframes[uNumSegments].position.xyz - keyframes[uNumSegments-1].position.xyz);
    vec3 pA = -pk00 + pk1;
    vec3 pB = 2.0*pk00 - 5.0*pk0 + 4.0*pk1 - pk2;
    vec3 pC = -pk00 + 3.0*pk0 - 3.0*pk1 + pk2;

    float maxPprime = length(vec3(
        quadMaxAbs(1.5*pC.x, pB.x, 0.5*pA.x, lt0, lt1),
        quadMaxAbs(1.5*pC.y, pB.y, 0.5*pA.y, lt0, lt1),
        quadMaxAbs(1.5*pC.z, pB.z, 0.5*pA.z, lt0, lt1)));

    // --- 스케일(scale) Catmull-Rom 계수 ---
    vec3 sk00 = (seg == 0) ? (2.0*keyframes[0].scale.xyz - keyframes[1].scale.xyz) : keyframes[seg-1].scale.xyz;
    vec3 sk0  = keyframes[seg].scale.xyz;
    vec3 sk1  = keyframes[seg+1].scale.xyz;
    vec3 sk2  = (seg+2 <= uNumSegments) ? keyframes[seg+2].scale.xyz
                                        : (2.0*keyframes[uNumSegments].scale.xyz - keyframes[uNumSegments-1].scale.xyz);
    vec3 sA = -sk00 + sk1;
    vec3 sB = 2.0*sk00 - 5.0*sk0 + 4.0*sk1 - sk2;
    vec3 sC = -sk00 + 3.0*sk0 - 3.0*sk1 + sk2;

    float maxSprime = length(vec3(
        quadMaxAbs(1.5*sC.x, sB.x, 0.5*sA.x, lt0, lt1),
        quadMaxAbs(1.5*sC.y, sB.y, 0.5*sA.y, lt0, lt1),
        quadMaxAbs(1.5*sC.z, sB.z, 0.5*sA.z, lt0, lt1)));

    float sMinX = max(cubicMin(0.5*sC.x, 0.5*sB.x, 0.5*sA.x, sk0.x, lt0, lt1), 1e-4);
    float sMinY = max(cubicMin(0.5*sC.y, 0.5*sB.y, 0.5*sA.y, sk0.y, lt0, lt1), 1e-4);
    float sMinZ = max(cubicMin(0.5*sC.z, 0.5*sB.z, 0.5*sA.z, sk0.z, lt0, lt1), 1e-4);
    float sMin = min(sMinX, min(sMinY, sMinZ));

    // --- |worldPos - p(t)| 의 상한 ---
    vec3 posAtLt0 = catmullRomPos(t0);
    float maxW = length(worldPos - posAtLt0) + maxPprime * (lt1 - lt0);

    // --- 회전: slerp는 lt에 대해 각속도가 일정하다 ---
    vec4 rot0 = keyframes[seg].rotation;
    vec4 rot1 = keyframes[seg+1].rotation;
    float cosA = clamp(dot(rot0, rot1), -1.0, 1.0);
    if (cosA < 0.0) cosA = -cosA;
    float omega = acos(cosA);

    return (omega * maxW + maxPprime) / sMin + maxW * maxSprime / (sMin * sMin);
}

// [a,b]가 키프레임 세그먼트 경계를 몇 번이든 걸칠 수 있는 일반적인 경우의 arc length 상한.
// 경계마다 구간을 잘라, 조각마다 maxSpeedBoundInSeg("하나의 세그먼트 안"이라는 전제)를 적용하고 합산한다.
float boundedArcLength(float a, float b, vec3 worldPos)
{
    float total = 0.0;
    float cur = a;

    // uNumSegments는 런타임 uniform이라 이 루프는 컴파일 타임에 펼쳐지지 않지만,
    // 가변 인덱스 배열 접근이 없으므로 레지스터→local memory spill 문제는 없다.
    for (int i = 0; i < uNumSegments && cur < b - 1e-9; ++i)
    {
        float ltStart;
        int segCur = getSegIdx(cur, ltStart);

        float segEndT  = float(segCur + 1) / float(uNumSegments);
        float pieceEnd = min(b, segEndT);

        float ltEnd = (pieceEnd >= segEndT - 1e-6) ? 1.0 : (pieceEnd * float(uNumSegments) - float(segCur));

        float speed = maxSpeedBoundInSeg(segCur, ltStart, ltEnd, cur, pieceEnd, worldPos);
        total += speed * (ltEnd - ltStart);

        cur = pieceEnd;
    }
    return total;
}

// [t0,t1] 동안 y(t)가 브러시 로컬 공간에서 갇혀 있는 범위를 중심점+반지름(구)으로 근사한다.
// 반지름 = 중간점에서 양 끝까지의 arc length 상한 중 큰 값 (arc length 상한은 직선 거리 상한도 자동으로 만족).
void computeLocalBoundingSphere(float t0, float t1, vec3 worldPos, out vec3 center, out float radius)
{
    float tMid = 0.5 * (t0 + t1);
    center = evalInvTransformAt(tMid, worldPos);

    float rL = boundedArcLength(t0, tMid, worldPos);
    float rR = boundedArcLength(tMid, t1, worldPos);
    radius = max(rL, rR);
}

// (center, radius)를 uvw 공간의 AABB로 바꾸고, 그 박스 크기에 맞는 min-mip 레벨을 골라
// texelFetch로 실제 최솟값을 조회한다. 반환값이 양수면 "이 범위 전체에서 표면과 만난 적이 없다"가
// grid 데이터로 증명된 것이다 (Lipschitz 상수 가정이 필요 없다).
float queryMinSDFInSphere(vec3 center, float radius)
{
    vec3 brushRange = uBrushMax - uBrushMin;
    vec3 uvwCenter  = (center - uBrushMin) / brushRange;
    vec3 uvwRadius  = radius / brushRange;

    vec3 rawMin = uvwCenter - uvwRadius;
    vec3 rawMax = uvwCenter + uvwRadius;

    // 구가 브러시 박스[0,1]^3와 아예 안 겹치면(멀리 떨어진 영역), 클램프해서 밉 레벨을 고르는 대신
    // 실제로 벗어난 거리를 그대로 반환한다.
    vec3 belowZero = max(-rawMax, vec3(0.0));
    vec3 aboveOne  = max(rawMin - vec3(1.0), vec3(0.0));
    vec3 outsideUVW = max(belowZero, aboveOne);
    if (any(greaterThan(outsideUVW, vec3(0.0))))
    {
        return length(outsideUVW * brushRange);
    }

    vec3 uvwMin = clamp(rawMin, vec3(0.0), vec3(1.0));
    vec3 uvwMax = clamp(rawMax, vec3(0.0), vec3(1.0));

    ivec3 baseRes = textureSize(uBrushSDF, 0);
    int maxLevel  = textureQueryLevels(uBrushSDF) - 1;

    vec3 texMin = uvwMin * vec3(baseRes);
    vec3 texMax = uvwMax * vec3(baseRes);
    float extent = max(texMax.x - texMin.x, max(texMax.y - texMin.y, texMax.z - texMin.z));

    int level = int(ceil(log2(max(extent, 1.0))));
    level = clamp(level, 0, maxLevel);

    float invScale = 1.0 / float(1 << level);
    ivec3 levelRes = max(baseRes >> level, ivec3(1));

    ivec3 idxMin = clamp(ivec3(floor(texMin * invScale)), ivec3(0), levelRes - ivec3(1));
    ivec3 idxMax = clamp(ivec3(floor(texMax * invScale)), ivec3(0), levelRes - ivec3(1));

    float m = 1e10;
    for (int z = idxMin.z; z <= idxMax.z; ++z)
    for (int y = idxMin.y; y <= idxMax.y; ++y)
    for (int x = idxMin.x; x <= idxMax.x; ++x)
        m = min(m, texelFetch(uBrushSDF, ivec3(x, y, z), level).r);

    return m;
}

// Brent's method: f(alpha) = SDF(T^-1(mix(t0,t1,alpha)) * worldPos) 를 alpha in [0,1]에서 최소화한다.
float brentMinimize(float t0, float t1, vec3 worldPos)
{
    const float golden = 0.381966;
    const float tol = 1e-4;

    float a = 0.0, b = 1.0;

    float x = a + golden * (b - a);
    float w = x, v = x;

    float fx = sampleLocalSDF(evalInvTransformAt(mix(t0, t1, x), worldPos));
    float fw = fx, fv = fx;

    float d = 0.0, e = 0.0;

    for (int iter = 0; iter < uMaxBrentIter; ++iter)
    {
        float mid  = 0.5 * (a + b);
        float tol1 = tol * abs(x) + 1e-10;
        float tol2 = 2.0 * tol1;

        if (abs(x - mid) <= (tol2 - 0.5 * (b - a)))
            break;

        bool useParabolic = false;
        float u = 0.0;

        if (abs(e) > tol1)
        {
            float r = (x - w) * (fx - fv);
            float q = (x - v) * (fx - fw);
            float p = (x - v) * q - (x - w) * r;
            q = 2.0 * (q - r);

            if (q > 0.0) p = -p; else q = -q;

            float etemp = e; e = d;

            if (abs(p) < abs(0.5 * q * etemp)
                && p > q * (a - x)
                && p < q * (b - x))
            {
                d = p / q;
                u = x + d;
                if ((u - a) < tol2 || (b - u) < tol2)
                    d = (x < mid) ? tol1 : -tol1;
                useParabolic = true;
            }
        }

        if (!useParabolic)
        {
            e = (x < mid) ? (b - x) : (a - x);
            d = golden * e;
        }

        u = (abs(d) >= tol1) ? x + d : x + ((d > 0.0) ? tol1 : -tol1);

        float fu = sampleLocalSDF(evalInvTransformAt(mix(t0, t1, u), worldPos));

        if (fu <= fx)
        {
            if (u < x) b = x; else a = x;
            v = w; fv = fw;
            w = x; fw = fx;
            x = u; fx = fu;
        }
        else
        {
            if (u < x) a = u; else b = u;
            if (fu <= fw || w == x)      { v = w; fv = fw; w = u; fw = fu; }
            else if (fu <= fv || v == x || v == w) { v = u; fv = fu; }
        }
    }

    return fx;
}

// 적응적 이등분의 depth 하나를 만드는 매크로. NAME은 이 depth의 함수 이름,
// NEXT는 컬링 실패 시 위임할 다음(한 단계 더 깊은) 함수 이름.
// 매크로 전개로 컴파일 타임에 완전히 펼쳐지므로 런타임 스택/가변 인덱스 배열이 전혀 없다.
#define DEFINE_SUBDIV(NAME, NEXT)                                          \
float NAME(float a, float b, vec3 worldPos)                                \
{                                                                            \
    vec3  center; float radius;                                            \
    computeLocalBoundingSphere(a, b, worldPos, center, radius);             \
    if (queryMinSDFInSphere(center, radius) > 0.0)                         \
    {                                                                       \
        vec3 pa = evalInvTransformAt(a, worldPos);                         \
        vec3 pb = evalInvTransformAt(b, worldPos);                         \
        return min(sampleLocalSDF(pa), sampleLocalSDF(pb));                \
    }                                                                       \
    float mid = 0.5 * (a + b);                                            \
    return min(NEXT(a, mid, worldPos), NEXT(mid, b, worldPos));            \
}

// 가장 깊은 leaf: 더는 안 쪼개고 곧바로 Brent에 넘긴다.
float evalLeaf(float a, float b, vec3 worldPos)
{
    vec3  center; float radius;
    computeLocalBoundingSphere(a, b, worldPos, center, radius);
    if (queryMinSDFInSphere(center, radius) > 0.0)
    {
        vec3 pa = evalInvTransformAt(a, worldPos);
        vec3 pb = evalInvTransformAt(b, worldPos);
        return min(sampleLocalSDF(pa), sampleLocalSDF(pb));
    }
    return brentMinimize(a, b, worldPos);
}

