#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0) uniform sampler3D uBrushSDF;
layout(r32f, binding = 1) uniform writeonly image3D uSweptVolume;

struct KeyFrame {
    vec4 position; // xyz = position, w unused
    vec4 rotation; // quaternion (x, y, z, w)
    vec4 scale;    // scale (x, y, z), w unused
};

layout(std430, binding = 2) buffer KeyFrameBuffer {
    KeyFrame keyframes[];
};

// chord-deviation per sampling step (size = uSamplingSteps - 1)
layout(std430, binding = 3) buffer DevBuffer {
    float devs[];
};

layout(std430, binding = 4) buffer BrentCounterBuffer {
    uint brentCallCount;
    uint outsideBoxCount;
};

uniform vec3  uVolumeMin;
uniform vec3  uVolumeMax;
uniform ivec3 uResolution;

uniform vec3 uBrushMin;
uniform vec3 uBrushMax;

uniform int uSamplingSteps;
uniform int uMaxBrentIter;
uniform int uNumSegments;

float sampleLocalSDF(vec3 localPos)
{
    vec3 brushRange = uBrushMax - uBrushMin;
    vec3 uvw = (localPos - uBrushMin) / brushRange;

    float outsideDist = 0.0;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
    {
        atomicAdd(outsideBoxCount, 1u); 

        vec3 clamped = clamp(uvw, vec3(0.0), vec3(1.0));
        vec3 diff = (uvw - clamped) * brushRange;
        outsideDist = length(diff);
        uvw = clamped;
    }

    return texture(uBrushSDF, uvw).r + outsideDist;
}

int getSegIdx(float t, out float lt)
{
    float scaled = clamp(t, 0.0, 1.0) * float(uNumSegments);
    int seg      = clamp(int(scaled), 0, uNumSegments - 1);
    lt           = scaled - float(seg);
    return seg;
}

vec3 catmullRomPos(float t)
{
    float lt;
    int seg = getSegIdx(t, lt);

    vec3 k00 = (seg == 0)
        ? (2.0 * keyframes[0].position.xyz - keyframes[1].position.xyz)
        : keyframes[seg - 1].position.xyz;

    vec3 k0 = keyframes[seg].position.xyz;
    vec3 k1 = keyframes[seg + 1].position.xyz;

    vec3 k2 = (seg + 2 <= uNumSegments)
        ? keyframes[seg + 2].position.xyz
        : (2.0 * keyframes[uNumSegments].position.xyz - keyframes[uNumSegments - 1].position.xyz);

    float lt2 = lt * lt;
    float lt3 = lt2 * lt;

    return 0.5 * ((2.0 * k0)
        + (-k00 + k1)                        * lt
        + (2.0*k00 - 5.0*k0 + 4.0*k1 - k2)  * lt2
        + (-k00 + 3.0*k0 - 3.0*k1 + k2)     * lt3);
}

vec4 quatSlerp(vec4 q1, vec4 q2, float t)
{
    float cosA = clamp(dot(q1, q2), -1.0, 1.0);
    if (cosA < 0.0) { q2 = -q2; cosA = -cosA; }
    if (cosA > 0.9995) return normalize(mix(q1, q2, t));

    float angle = acos(cosA);
    float sinA  = sin(angle);
    return (sin((1.0 - t) * angle) / sinA) * q1
         + (sin(t * angle)         / sinA) * q2;
}

// v' = q * v * q^{-1}
vec3 quatRotate(vec4 q, vec3 v)
{
    vec3 qv = q.xyz;
    return v + 2.0 * cross(qv, cross(qv, v) + q.w * v);
}

vec3 evalInvTransformAt(float t, vec3 worldPos)
{
    float lt;
    int seg = getSegIdx(t, lt);

    vec3 pos    = catmullRomPos(t);
    vec4 rot    = quatSlerp(keyframes[seg].rotation, keyframes[seg + 1].rotation, lt);
    vec4 invRot = vec4(-rot.xyz, rot.w);
    vec3 scl    = mix(keyframes[seg].scale.xyz, keyframes[seg + 1].scale.xyz, lt);

    return quatRotate(invRot, (worldPos - pos) / scl);
}

// 교차원 반경 찾기
float intersectionRadius(float sdf0, float sdf1, float d)
{
    float tStar = (d * d + sdf0 * sdf0 - sdf1 * sdf1) / (2.0 * d * d);
    return sqrt(max(sdf0 * sdf0 - (tStar * d) * (tStar * d), 0.0));
}

// 1-Lipschitz lower bound on the minimum along a chord of length d
float lipschitzMin(float sdf0, float sdf1, float d)
{
    return (sdf0 + sdf1 - d) * 0.5;
}

// Brent's method: minimize f(alpha) = SDF(T^{-1}(mix(t0,t1,alpha)) * worldPos)
float brentMinimize(float t0, float t1, vec3 worldPos)
{
    const float golden = 0.381966;
    const float tol    = 1e-4;

    float a = 0.0, b = 1.0;

    float x  = a + golden * (b - a);
    float w  = x, v = x;
    float fx = sampleLocalSDF(evalInvTransformAt(mix(t0, t1, x), worldPos));
    float fw = fx, fv = fx;
    float d  = 0.0, e = 0.0;

    for (int iter = 0; iter < uMaxBrentIter; ++iter)
    {
        float mid  = 0.5 * (a + b);
        float tol1 = tol * abs(x) + 1e-10;
        float tol2 = 2.0 * tol1;

        if (abs(x - mid) <= (tol2 - 0.5 * (b - a)))
            break;

        bool  useParabolic = false;
        float u = 0.0;

        if (abs(e) > tol1)
        {
            float r = (x - w) * (fx - fv);
            float q = (x - v) * (fx - fw);
            float p = (x - v) * q - (x - w) * r;
            q = 2.0 * (q - r);

            if (q > 0.0) p = -p; else q = -q;

            float etemp = e; e = d;

            if (abs(p) < abs(0.5 * q * etemp)
                && p > q * (a - x)
                && p < q * (b - x))
            {
                d = p / q;
                u = x + d;
                if ((u - a) < tol2 || (b - u) < tol2)
                    d = (x < mid) ? tol1 : -tol1;
                useParabolic = true;
            }
        }

        if (!useParabolic)
        {
            e = (x < mid) ? (b - x) : (a - x);
            d = golden * e;
        }

        u = (abs(d) >= tol1) ? x + d : x + ((d > 0.0) ? tol1 : -tol1);

        float fu = sampleLocalSDF(evalInvTransformAt(mix(t0, t1, u), worldPos));

        if (fu <= fx)
        {
            if (u < x) b = x; else a = x;
            v = w; fv = fw;
            w = x; fw = fx;
            x = u; fx = fu;
        }
        else
        {
            if (u < x) a = u; else b = u;
            if (fu <= fw || w == x)              { v = w; fv = fw; w = u; fw = fu; }
            else if (fu <= fv || v == x || v == w) { v = u; fv = fu; }
        }
    }

    return fx;
}

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, uResolution))) return;

    vec3 volumeRange = uVolumeMax - uVolumeMin;
    vec3 spacing     = volumeRange / vec3(uResolution - 1);
    vec3 worldPos    = uVolumeMin + vec3(id) * spacing;

    float minSDF = 1e10;

    float t0   = 0.0;
    vec3  p0   = evalInvTransformAt(t0, worldPos);
    float sdf0 = sampleLocalSDF(p0);

    for (int seg = 0; seg < uSamplingSteps - 1; ++seg)
    {
        float t1 = float(seg + 1) / float(uSamplingSteps - 1);

        vec3  p1       = evalInvTransformAt(t1, worldPos);
        float sdf1     = sampleLocalSDF(p1);
        float chordLen = length(p1 - p0);
        float dev      = devs[seg];

        float effSdf0 = sdf0 - dev;
        float effSdf1 = sdf1 - dev;
        float sdfMin  = min(sdf0, sdf1);

        if (effSdf0 > 0.0 && effSdf1 > 0.0 && (effSdf0 + effSdf1) > chordLen)
        {
            minSDF = min(minSDF, sdfMin);
        }
        else
        {
            const int M = 5;
            float bestSDF = min(sdf0, sdf1);

            float tPrev   = t0;
            vec3  pPrev   = p0;
            float sdfPrev = sdf0;

            for (int i = 1; i <= M; ++i)
            {
                float tCurr   = mix(t0, t1, float(i) / float(M)); // [t0, t1]를 M등분한 샘플링
                vec3  pCurr   = evalInvTransformAt(tCurr, worldPos);
                float sdfCurr = sampleLocalSDF(pCurr);
                float subLen  = length(pCurr - pPrev);

                // sub-segment 자신의 deviation (CPU에서 devs[seg*M + (i-1)]에 미리 계산해둔 값)
                float subDev    = devs[seg * M + (i - 1)];
                float effSdfPrev = sdfPrev - subDev;
                float effSdfCurr = sdfCurr - subDev;
                float subSdfMin   = min(sdfPrev, sdfCurr);

                if (effSdfPrev > 0.0 && effSdfCurr > 0.0 && (effSdfPrev + effSdfCurr) > subLen)
                {
                    bestSDF = min(bestSDF, subSdfMin);
                }
                else
                {
                    atomicAdd(brentCallCount, 1u);
                    float val = brentMinimize(tPrev, tCurr, worldPos);
                    bestSDF = min(bestSDF, val);
                }

                tPrev   = tCurr;
                pPrev   = pCurr;
                sdfPrev = sdfCurr;
            }

            minSDF = min(minSDF, bestSDF);
        }

        t0   = t1;
        p0   = p1;
        sdf0 = sdf1;
    }

    imageStore(uSweptVolume, id, vec4(minSDF, 0.0, 0.0, 0.0));
}