#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0) uniform sampler3D uBrushSDF;
layout(r32f, binding = 1) uniform writeonly image3D uSweptVolume;

// Control points: position(xyz) + rotation quaternion(xyzw)
struct ControlPoint {
    vec4 position; // xyz = position, w unused
    vec4 rotation; // quaternion (x, y, z, w)
};

layout(std430, binding = 2) buffer ControlPointBuffer {
    ControlPoint controlPoints[4];
};

uniform vec3 uVolumeMin;
uniform vec3 uVolumeMax;
uniform ivec3 uResolution;

uniform vec3 uBrushMin;
uniform vec3 uBrushMax;

uniform int uSamplingSteps;


float sampleLocalSDF(vec3 localPos)
{
    vec3 brushRange = uBrushMax - uBrushMin;
    vec3 uvw = (localPos - uBrushMin) / brushRange;

    float outsideDist = 0.0;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
    {
        vec3 clamped = clamp(uvw, vec3(0.0), vec3(1.0));
        vec3 diff = (uvw - clamped) * brushRange;
        outsideDist = length(diff);
        uvw = clamped;
    }

    return texture(uBrushSDF, uvw).r + outsideDist;
}


// Cubic bezier position from control points
vec3 cubicBezierPos(float t)
{
    float u = 1.0 - t;
    return u*u*u * controlPoints[0].position.xyz
         + 3.0*u*u*t * controlPoints[1].position.xyz
         + 3.0*u*t*t * controlPoints[2].position.xyz
         + t*t*t     * controlPoints[3].position.xyz;
}

// Quaternion SLERP
vec4 quatSlerp(vec4 q1, vec4 q2, float t)
{
    float cosA = clamp(dot(q1, q2), -1.0, 1.0);
    if (cosA < 0.0) { q2 = -q2; cosA = -cosA; }
    if (cosA > 0.9995) return normalize(mix(q1, q2, t));
    float angle = acos(cosA);
    float sinA = sin(angle);
    return (sin((1.0 - t) * angle) / sinA) * q1
         + (sin(t * angle)          / sinA) * q2;
}

// Rotate vector by quaternion
vec3 quatRotate(vec4 q, vec3 v)
{
    vec3 qv = q.xyz;
    return v + 2.0 * cross(qv, cross(qv, v) + q.w * v);
}

// T^{-1}(t) * worldPos — rigid body inverse: R^T * (worldPos - pos)
vec3 evalInvTransformAt(float t, vec3 worldPos)
{
    vec3 pos = cubicBezierPos(t);
    vec4 rot  = quatSlerp(controlPoints[0].rotation, controlPoints[3].rotation, t);
    vec4 invRot = vec4(-rot.xyz, rot.w); // conjugate = inverse for unit quaternion
    return quatRotate(invRot, worldPos - pos);
}


// Brent's method: f(alpha) = SDF(T^{-1}(mix(t0,t1,alpha)) * worldPos)
float brentMinimize(float t0, float t1, vec3 worldPos)
{
    const float golden = 0.381966;
    const int maxIter = 20;
    const float tol = 1e-4;

    float a = 0.0, b = 1.0;

    float x = a + golden * (b - a);
    float w = x, v = x;
    float fx = sampleLocalSDF(evalInvTransformAt(mix(t0, t1, x), worldPos));
    float fw = fx, fv = fx;

    float d = 0.0, e = 0.0;

    for (int iter = 0; iter < maxIter; ++iter)
    {
        float mid  = 0.5 * (a + b);
        float tol1 = tol * abs(x) + 1e-10;
        float tol2 = 2.0 * tol1;

        if (abs(x - mid) <= (tol2 - 0.5 * (b - a)))
            break;

        bool useParabolic = false;
        float u = 0.0;

        if (abs(e) > tol1)
        {
            float r = (x - w) * (fx - fv);
            float q = (x - v) * (fx - fw);
            float p = (x - v) * q - (x - w) * r;
            q = 2.0 * (q - r);

            if (q > 0.0) p = -p; else q = -q;

            float etemp = e; e = d;

            if (abs(p) < abs(0.5 * q * etemp)
                && p > q * (a - x)
                && p < q * (b - x))
            {
                d = p / q;
                u = x + d;
                if ((u - a) < tol2 || (b - u) < tol2)
                    d = (x < mid) ? tol1 : -tol1;
                useParabolic = true;
            }
        }

        if (!useParabolic)
        {
            e = (x < mid) ? (b - x) : (a - x);
            d = golden * e;
        }

        u = (abs(d) >= tol1) ? x + d : x + ((d > 0.0) ? tol1 : -tol1);

        float fu = sampleLocalSDF(evalInvTransformAt(mix(t0, t1, u), worldPos));

        if (fu <= fx)
        {
            if (u < x) b = x; else a = x;
            v = w; fv = fw;
            w = x; fw = fx;
            x = u; fx = fu;
        }
        else
        {
            if (u < x) a = u; else b = u;
            if (fu <= fw || w == x)      { v = w; fv = fw; w = u; fw = fu; }
            else if (fu <= fv || v == x || v == w) { v = u; fv = fu; }
        }
    }

    return fx;
}


void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, uResolution))) return;

    vec3 volumeRange = uVolumeMax - uVolumeMin;
    vec3 spacing     = volumeRange / vec3(uResolution - 1);
    vec3 worldPos    = uVolumeMin + vec3(id) * spacing;

    float minSDF = 1e10;

    for (int seg = 0; seg < uSamplingSteps - 1; ++seg)
    {
        float t0 = float(seg)     / float(uSamplingSteps - 1);
        float t1 = float(seg + 1) / float(uSamplingSteps - 1);

        // Segment endpoints on actual curve
        vec3 p0 = evalInvTransformAt(t0, worldPos);
        vec3 p1 = evalInvTransformAt(t1, worldPos);

        float sdf0 = sampleLocalSDF(p0);
        float sdf1 = sampleLocalSDF(p1);
        float segLength = length(p1 - p0);

        // Lipschitz early exit
        if (sdf0 > 0.0 && sdf1 > 0.0 && (sdf0 + sdf1) > segLength)
        {
            minSDF = min(minSDF, min(sdf0, sdf1));
            continue;
        }

        float bestSDF = brentMinimize(t0, t1, worldPos);
        bestSDF = min(bestSDF, min(sdf0, sdf1));
        minSDF  = min(minSDF, bestSDF);
    }

    imageStore(uSweptVolume, id, vec4(minSDF, 0.0, 0.0, 0.0));
}