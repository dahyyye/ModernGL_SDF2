#version 430 core

layout(local_size_x = 256) in;

// SV의 SDF 3D 텍스처
layout(binding = 0) uniform sampler3D uSvSDF;

// 장애물 정점 입력 (vec4, xyz만 사용)
layout(std430, binding = 0) buffer VertexInput {
    vec4 vertices[];
};

// 결과: 정점별 SDF 값
layout(std430, binding = 1) buffer SDFOutput {
    float sdfValues[];
};

uniform vec3 uSvMin;
uniform vec3 uSvMax;
uniform int  uNumVertices;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(uNumVertices)) return;

    vec3 worldPos = vertices[idx].xyz;
    vec3 uvw = (worldPos - uSvMin) / (uSvMax - uSvMin);

    // SV AABB 밖이면 충돌 아님
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
    {
        sdfValues[idx] = 1e10;
        return;
    }

    sdfValues[idx] = texture(uSvSDF, uvw).r;
}